# Registry/.env — sao chép thành .env ở GỐC repo rồi điền. KHÔNG commit .env thật.
#
# THIẾU credential hoặc tham số còn giá trị mẫu → chế độ KHÔ (apply tham số + dựng plan,
# KHÔNG đọc chuỗi, KHÔNG dựng tx).

# ── Cần để dựng tx thật ───────────────────────────────────────────
BLOCKFROST_KEY=
PRIVATE_KEY=
# hoặc:
WALLET_SEED=

NETWORK=Preview

# ── Sổ đăng ký ────────────────────────────────────────────────────
# registry_authority: payment key-hash (28-byte hex) ký mỗi đăng ký/cập nhật.
# Trống → giá trị mẫu (KHÔNG ký được — chỉ apply tham số + in hash).
REGISTRY_AUTHORITY=

# ── Kho của dịch vụ (do CHÍNH đội dịch vụ cấp — Registry không dựng kho) ──
# custody_hash: script hash kho.       seed_policy: policy NFT authenticity của kho.
# custody_utxo: ô kho mang NFT authenticity, dạng "txhash#index" — bước đăng ký readFrom nó.
CUSTODY_HASH=
SEED_POLICY=
CUSTODY_UTXO=

# governance_ref: script hash cổng quản trị RIÊNG của dịch vụ. Trống → giá trị mẫu.
GOVERNANCE_REF=

# ── R-GOVLIVE: cổng quản trị PHẢI CHẠY trong chính tx đăng ký ──────
# Validator đòi VÔ ĐIỀU KIỆN một trong hai (registry_beacon.ak, mục R-GOVLIVE):
#   spend      — tx chi tiêu một ô ở Script(governance_ref). Nhánh spend đó KHÔNG được
#                mint/burn: R-MINT-2 cấm tx đăng ký mang policy mint nào khác beacon.
#   withdrawal — tx rút 0 lovelace từ Script(governance_ref). Không đụng tx.mint ⇒ an toàn
#                với R-MINT-2. Đây là đường khuyên dùng.
# Thiếu phần này → chế độ KHÔ (không dựng tx), vì tx dựng ra sẽ bị từ chối 100%.
GOVERNANCE_CONSENT_KIND=
# Mã script cổng quản trị ĐÃ apply tham số (hex). Script đăng ký ĐỐI CHIẾU hash của nó với
# GOVERNANCE_REF trước khi dùng — nộp nhầm script là hỏng ngay, không phải lúc submit.
GOVERNANCE_SCRIPT_CBOR=
# Redeemer (CBOR hex) cho nhánh đồng thuận của cổng quản trị.
GOVERNANCE_REDEEMER=
# Chỉ với kind=spend: ô ở Script(governance_ref) sẽ bị chi tiêu, dạng "txhash#index".
GOVERNANCE_UTXO=

# created_epoch: trống → lấy epoch hiện tại (an toàn hơn: khớp cửa sổ hiệu lực của tx).
CREATED_EPOCH=
# Cửa sổ hiệu lực tx tính từ lúc chạy (ms). Mặc định 1 giờ.
TX_TTL_MS=3600000

# ── Policy token thật (điền sau khi phát hành) ────────────────────
LAMP_POLICY_ID=
MAGIC_POLICY_ID=

# ── Tuỳ chọn: chạy luôn bước dựng kho trong cùng lượt ─────────────
# Trỏ tới thư mục offchain/src của Treasury SDK. Script nạp `planSeed` lúc chạy rồi TIÊM vào
# onboardPlatform. Bỏ trống → chỉ đăng ký (kho do đội dịch vụ tự dựng trước).
TREASURY_SDK=
