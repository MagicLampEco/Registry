{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "NodeNext",
    "moduleResolution": "NodeNext",
    "lib":              ["ES2022"],
    "types":            ["node"],
    "strict":           true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "skipLibCheck":     true,
    "noEmit":           true,
    "sourceMap":        true
  },
  "include": ["offchain/src/**/*", "examples/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "scripts", "onchain"]
}
